# Optional server-side Gemini key. Dictionary translation is used without it.
GEMINI_API_KEY=

# Supabase server-side credentials. Never expose the service-role key to browsers.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin login secrets. Use a unique password and a random session secret (32+ bytes).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
